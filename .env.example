# 复制为 .env 后填写。不要提交 .env 或任何真实 API Key。
AI_API_KEY=your_api_key_here
# OpenAI 使用默认值即可；兼容供应商通常需要修改这两个值。
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
# responses（OpenAI Responses API）或 chat-completions（兼容接口）
AI_API_PROTOCOL=responses
# 【可选】主模型拥塞时自动改用的备用模型（逗号分隔，按顺序尝试）。
# 留空则用服务端内置的降级链（仅 commandcode 网关自动生效，见 docs/compose-fix-notes.md）。
# AI_FALLBACK_MODELS=reflection/beam:free,ornith/ornith-1.5-122b:free
PORT=8123
