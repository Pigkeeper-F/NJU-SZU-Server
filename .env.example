# 复制为 .env 后填写。不要提交 .env 或任何真实 API Key。
AI_API_KEY=your_api_key_here
# OpenAI 使用默认值即可；兼容供应商通常需要修改这两个值。
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
# responses（OpenAI Responses API）或 chat-completions（兼容接口）
AI_API_PROTOCOL=responses
# 【可选】主模型拥塞时自动改用的备用模型（逗号分隔，按顺序尝试）。
# 留空则用服务端内置的降级链（仅 commandcode 网关自动生效，见 docs/compose-fix-notes.md）。
# AI_FALLBACK_MODELS=reflection/beam:free,ornith/ornith-1.5-122b:free
PORT=8123

# 开放 API 检索源的可选凭据（没有也能用，只是限流更紧）：
# NCBI_API_KEY=          # PubMed/PMC，配了 10 请求/秒（无 key 3 请求/秒）
# NCBI_EMAIL=            # NCBI 建议附联系邮箱
# OPENALEX_API_KEY=      # OpenAlex polite pool
# SEMANTIC_SCHOLAR_API_KEY=  # Semantic Scholar；无 key 走共享池、常 429，建议申请

# 文件下载默认沿用 Windows 已启用的系统代理；其他环境可明确配置无认证 HTTP 代理。
# SOURCE_DOWNLOAD_PROXY=http://127.0.0.1:7890

# ---------------------------------------------------------------- 公共 API（可选）
# 管理员在服务器上配一套公共模型通道，供个人测试用。
# 学生在「添加 API → 自定义」里可以选「服务器 API」使用它，无需自己填 Key。
# 三项都配齐才算可用；PUBLIC_AI_KEY 只在服务端使用，绝不下发给浏览器。
# PUBLIC_AI_BASE_URL=https://your-gateway/v1
# PUBLIC_AI_KEY=sk-...
# PUBLIC_AI_MODEL=gpt-5.6-sol
# PUBLIC_AI_PROTOCOL=chat-completions   # 或 responses

# 可选的多个模型（逗号分隔）。为空则只提供 PUBLIC_AI_MODEL 一个。
# 只暴露白名单内的模型：客户端传别的名字会被忽略，避免拿站长的 key 跑贵模型。
# PUBLIC_AI_MODELS=model-a:free,model-b:free
# 每个模型的提示（界面红字显示）。格式 模型名|提示，逗号分隔。
# PUBLIC_AI_MODEL_NOTES=model-a:free|此模型不稳定，且性能不好(免费缘故),model-b:free|同上

# 单次请求的输出上限（tokens）。推理型模型会把额度用在 thinking 上，
# 太小会导致 content 为空（实测 300 全被推理吃掉）。默认 4000。
# AI_MAX_TOKENS=4000
