# 研序 · 研究工作台 —— 服务器部署配置
# 位置：/home/LZ/yanxu/repo/.env（不要提交到仓库，.gitignore 已忽略）

# ---------------------------------------------------------------- 监听
# 绑定 0.0.0.0 才能被校外/校内其他机器访问；端口 18700 已实测外网可达。
PORT=18700
HOST=0.0.0.0

# ---------------------------------------------------------------- 访问白名单
# 【必填】浏览器地址栏里的主机名:端口。少了它所有请求都会 403（Host 校验）。
# 换端口或换成域名时，这里必须同步改。
PUBLIC_HOSTS=114.212.75.219:18700
PUBLIC_ORIGINS=http://114.212.75.219:18700

# ---------------------------------------------------------------- 多用户模式
# 1 = 每个访问者必须用自己填的 API Key；服务端不提供任何共享 Key。
# 这样老师和同学各自消耗自己的额度，不会烧掉站长的。
REQUIRE_USER_KEY=1

# 每人每分钟最多多少次 AI/执行请求（按 IP 计）。
RATE_LIMIT_MAX=30

# ---------------------------------------------------------------- 更新日志
# 老师看的那一页读的就是这个仓库的提交历史。
CHANGELOG_REPO=Pigkeeper-F/NJU-SZU-Server
CHANGELOG_BRANCH=main
CHANGELOG_LIMIT=60
# 仓库是公开的，不需要 token。日后转私有：填一个只读 token 到下面这行。
# GITHUB_TOKEN=

# ---------------------------------------------------------------- 注意
# 刻意**不**配置 AI_API_KEY：多人模式下服务端不持有任何 Key。
# 本文件也不要写任何真实密钥——它是给全班访问的服务。
