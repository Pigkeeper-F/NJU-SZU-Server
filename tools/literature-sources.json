{
  "version": 2,
  "sources": [
    {
      "key": "google-scholar",
      "label": "Google Scholar",
      "state": "executable",
      "access": "browser",
      "adapter": {
        "kind": "soc-script",
        "script": "SOC-database-pipeline-clean/.codex/skills/soc-paper-fetch/scripts/google_scholar_search.py"
      },
      "idPrefix": "GSC",
      "notes": "首批连接器（2026-10-15）；可能要求人机验证，不自动绕过"
    },
    {
      "key": "cnki",
      "label": "知网",
      "state": "executable",
      "access": "browser",
      "adapter": {
        "kind": "browser-script",
        "script": "tools/literature_browser.py"
      },
      "idPrefix": "CNKI",
      "notes": "官方页面人工登录与权限核对后检索"
    },
    {
      "key": "wanfang",
      "label": "万方",
      "state": "executable",
      "access": "browser",
      "adapter": {
        "kind": "browser-script",
        "script": "tools/literature_extra_sources.py"
      },
      "idPrefix": "WF",
      "notes": "官方页面人工登录、验证与访问权限核对后检索"
    },
    {
      "key": "web-of-science",
      "label": "Web of Science",
      "state": "executable",
      "access": "browser",
      "adapter": {
        "kind": "browser-script",
        "script": "tools/literature_browser.py"
      },
      "idPrefix": "WOS",
      "notes": "核心合集；官方页面人工登录与机构权限核对后检索"
    },
    {
      "key": "scopus",
      "label": "Scopus",
      "state": "executable",
      "access": "browser",
      "adapter": {
        "kind": "browser-script",
        "script": "tools/literature_extra_sources.py"
      },
      "idPrefix": "SCOPUS",
      "notes": "Documents 的 Title Abstract Keywords 检索；官方页面人工登录与机构权限核对"
    },
    {
      "key": "pubmed",
      "label": "PubMed",
      "state": "executable",
      "access": "api",
      "adapter": {
        "kind": "public-api",
        "script": "tools/literature_pubmed.py"
      },
      "idPrefix": "PMID",
      "credentialEnv": [
        "NCBI_API_KEY",
        "NCBI_EMAIL"
      ],
      "rateLimit": "3 请求/秒（配置 NCBI_API_KEY 后 10 请求/秒）",
      "notes": "NCBI E-utilities 公开题录与摘要检索通常无需登录；必要时同来源官方网页续跑"
    },
    {
      "key": "pmc",
      "label": "PMC",
      "state": "executable",
      "access": "api",
      "adapter": {
        "kind": "open-api",
        "module": "pmc",
        "endpoint": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/"
      },
      "idPrefix": "PMC",
      "credentialEnv": [
        "NCBI_API_KEY",
        "NCBI_EMAIL"
      ],
      "rateLimit": "3 请求/秒（配置 NCBI_API_KEY 后 10 请求/秒）",
      "fulltext": "开放获取子集有正文（其余仅题录）",
      "notes": "PubMed Central 开放获取子集；版权与 OA 许可限制，取不到即标待补充"
    },
    {
      "key": "openalex",
      "label": "OpenAlex",
      "state": "executable",
      "access": "api",
      "adapter": {
        "kind": "open-api",
        "module": "openalex",
        "endpoint": "https://api.openalex.org/works"
      },
      "idPrefix": "OAX",
      "credentialEnv": [
        "OPENALEX_API_KEY",
        "OPENALEX_MAILTO"
      ],
      "rateLimit": "单请求 100 请求/秒上限；免密时按共享 IP 日配额计费，可能返回 429",
      "fulltext": "metadata-only；附开放获取链接（OA landing/pdf）",
      "notes": "无需登录；建议配置 OPENALEX_API_KEY 与 OPENALEX_MAILTO 进入 polite pool"
    },
    {
      "key": "semantic-scholar",
      "label": "Semantic Scholar",
      "state": "executable",
      "access": "api",
      "adapter": {
        "kind": "open-api",
        "module": "semantic-scholar",
        "endpoint": "https://api.semanticscholar.org/graph/v1/paper/search"
      },
      "idPrefix": "SS",
      "credentialEnv": [
        "SEMANTIC_SCHOLAR_API_KEY"
      ],
      "rateLimit": "无 key 走共享池（常 429）；申请免费 key 后约 100 请求/秒",
      "fulltext": "abstract；开放获取 PDF 走 openAccessPdf 链接",
      "notes": "覆盖中英文期刊（中文期刊元数据来自 CNKI/Wanfang），无登录；建议申请免费 API Key"
    },
    {
      "key": "europe-pmc",
      "label": "Europe PMC",
      "state": "executable",
      "access": "api",
      "adapter": {
        "kind": "open-api",
        "module": "europe-pmc",
        "endpoint": "https://www.ebi.ac.uk/europepmc/webservices/rest/search"
      },
      "idPrefix": "EPMC",
      "credentialEnv": [],
      "rateLimit": "约 10 请求/秒（共享 IP 共享配额）",
      "fulltext": "开放获取文献多数有正文（fullTextUrlList 标注 OA）",
      "notes": "EBI 官方 REST；resultType=core 返回摘要/MeSH/全文链接"
    }
  ]
}
